{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@hono/trpc-server": "^0.4.2",
    "@mastra-agents/api": "workspace:*",
    "@mastra-agents/env": "workspace:*",
    "@trpc/server": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mastra-agents/config": "workspace:*",
    "@types/node": "^22.20.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "catalog:"
  }
}
